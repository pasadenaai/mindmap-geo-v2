# Copy to .env.aws and fill in — never commit .env.aws
APP_ENV=aws
SECRETS_BACKEND=aws
STORAGE_BACKEND=dynamo

AWS_REGION=us-east-1
AWS_SECRET_NAME=pai-mindmap-geo/app

# Auth (SECRET_KEY must be set in Secrets Manager under pai-mindmap-geo/app (CDK creates and generates it))
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1

DYNAMO_GEO_POINTS_TABLE=geo_points
DYNAMO_GEO_ARCS_TABLE=geo_arcs
DYNAMO_GEO_CONFIGS_TABLE=geo_configs

S3_GEO_BUCKET=pai-mindmap-geo-assets-<ACCOUNT_ID>

CORS_ORIGINS=["https://your-domain.com"]
