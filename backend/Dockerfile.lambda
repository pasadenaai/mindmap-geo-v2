# ── Build stage ────────────────────────────────────────────────────────────
FROM public.ecr.aws/lambda/python:3.12 AS builder

WORKDIR /build

COPY requirements.aws.txt .
RUN pip install --no-cache-dir --target /install -r requirements.aws.txt

# ── Runtime stage ──────────────────────────────────────────────────────────
FROM public.ecr.aws/lambda/python:3.12

# Copy installed packages from builder
COPY --from=builder /install ${LAMBDA_TASK_ROOT}

# Copy application source and seed data
COPY app/ ${LAMBDA_TASK_ROOT}/app/
COPY data/ ${LAMBDA_TASK_ROOT}/data/

# AWS runtime settings — actual values come from Lambda env
ENV APP_ENV=aws
ENV SECRETS_BACKEND=env
ENV AWS_REGION=us-east-1

# Lambda handler: module.attribute
CMD ["app.main.handler"]
