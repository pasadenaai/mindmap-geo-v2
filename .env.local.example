# Local development settings. Do not edit this file with real values.
# Run `scripts/dev_env_init.sh` to generate .env.local (git-ignored, mode 600).
APP_ENV=local
SECRETS_BACKEND=env
STORAGE_BACKEND=dynamo

# Auth — SECRET_KEY is generated per developer by dev_env_init.sh
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOW_REGISTRATION=true
REFRESH_TOKEN_EXPIRE_DAYS=7

# External data sources (optional) — https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# LocalStack
DYNAMODB_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localstack:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4570
S3_GEO_BUCKET=geo-assets-local

# Only used by the dynamodb-admin container (pass with --env-file .env.local)
LOCALSTACK_ACCESS_KEY_ID=
LOCALSTACK_SECRET_ACCESS_KEY=

# CORS — frontend dev server
CORS_ORIGINS=["http://localhost:4203","http://localhost:8004"]
